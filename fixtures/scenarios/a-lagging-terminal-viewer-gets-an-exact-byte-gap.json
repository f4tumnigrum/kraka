              "subscriptionId": "desktop-terminal",
              "from": "262152",
              "to": "262155",
              "content": "content-tail"
            }
          ]
        }
      ]
    },
    {
      "deviceId": "tablet",
      "principalId": "person-lee",
      "connections": [
        {
          "environmentId": "studio",
          "connectionId": "tablet-studio-first",
