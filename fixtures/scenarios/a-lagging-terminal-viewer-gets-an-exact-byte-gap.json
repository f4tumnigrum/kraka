    {
      "label": "slow-viewer-consumes",
      "event": {
        "kind": "window",
        "environmentId": "studio",
        "deviceId": "desktop",
        "update": {
          "lane": "window",
          "epoch": "desktop-studio-first",
          "streamId": 1,
          "consumedBytes": 4096,
          "limitBytes": 8192
        }
      }
    },
    {
      "label": "append-tail",
      "event": {
        "kind": "terminalOutput",
        "environmentId": "studio",
        "address": {
          "threadId": "thread-notes",
          "terminalId": "term-notes",
          "generation": "1"
