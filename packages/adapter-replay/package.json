  "scripts": {
    "build": "bun build src/index.ts --outfile ../../.build/packages/adapter-replay.js"
  },
  "dependencies": {
    "@kraka/environment": "workspace:*",
    "@kraka/protocol": "workspace:*",
    "valibot": "1.5.0"
  }
}
