{
  "name": "kraka",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5 <1.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format:check": "biome format .",
    "lint": "biome lint . && bun run check:boundaries",
    "typecheck": "bun check && bun check --project packages/client-runtime/tsconfig.json && bun check --project packages/browser-host/tsconfig.json",
    "test": "bun test",
    "build": "bun -e \"require('node:fs').mkdirSync('.build/packages', { recursive: true })\" && bun run --filter '*' build",
    "protocol:reference": "bun tools/protocol-reference.ts",
    "protocol:reference:check": "bun tools/protocol-reference.ts --check",
    "check:boundaries": "bun tools/check-boundaries.ts",
    "perf": "bun tools/perf.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@kraka/adapter-replay": "workspace:*",
    "@kraka/environment": "workspace:*",
    "@kraka/protocol": "workspace:*",
    "@valibot/to-json-schema": "1.8.0",
    "bun-types": "1.4.5",
    "valibot": "1.5.0"
  }
}
